<ui:FluentWindow x:Class="WinRescuePro.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="{DynamicResource AppTitle}"
                 Width="1200" Height="800"
                 MinWidth="1000" MinHeight="700"
                 WindowStartupLocation="CenterScreen"
                 Background="#0F172A"
                 ExtendsContentIntoTitleBar="True">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- الهيدر -->
        <Border Grid.Row="0" Background="#1E293B" Padding="20" CornerRadius="0,0,12,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- الشعار -->
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Image Source="Assets/icon_shield.png" Width="50" Height="50" Margin="0,0,15,0"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{DynamicResource AppTitle}" 
                                   FontSize="24" FontWeight="Bold" Foreground="White"/>
                        <TextBlock Text="{DynamicResource SecurityStatus}" 
                                   FontSize="14" Foreground="#4ADE80"/>
                    </StackPanel>
                </StackPanel>

                <!-- زر اللغة -->
                <Button Grid.Column="2" Content="{DynamicResource LangButton}"
                        Click="BtnToggleLang_Click"
                        Background="#3B82F6" Foreground="White"
                        Padding="20,10" FontSize="14"/>
            </Grid>
        </Border>

        <!-- المحتوى الرئيسي -->
        <Grid Grid.Row="1" Margin="20">
            <Grid.ColumnDefinitions>
                <!-- العمود الأيسر: الشاشة السوداء -->
                <ColumnDefinition Width="*"/>
                <!-- العمود الأيمن: البطاقات -->
                <ColumnDefinition Width="380"/>
            </Grid.ColumnDefinitions>

            <!-- الشاشة السوداء الذكية -->
            <Border Grid.Column="0" Background="#0F172A" 
                    CornerRadius="12" Padding="20"
                    BorderBrush="#334155" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="{DynamicResource ConsoleTitle}"
                               FontSize="16" FontWeight="Bold" Foreground="#3B82F6"
                               Margin="0,0,0,15"/>

                    <!-- صندوق السجل -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                  x:Name="LogScrollViewer">
                        <TextBox x:Name="LogTextBox"
                                 Background="Transparent"
                                 Foreground="#4ADE80"
                                 FontFamily="Consolas"
                                 FontSize="13"
                                 TextWrapping="Wrap"
                                 IsReadOnly="True"
                                 BorderThickness="0"
                                 Text="{DynamicResource ConsoleReady}"/>
                    </ScrollViewer>

                    <!-- شريط التقدم -->
                    <ProgressBar Grid.Row="2" x:Name="ProgressBar"
                                 Height="6" Margin="0,15,0,0"
                                 Minimum="0" Maximum="100"
                                 Background="#1E293B"
                                 Foreground="#3B82F6"/>
                </Grid>
            </Border>

            <!-- العمود الأيمن: البطاقات -->
            <ScrollViewer Grid.Column="1" Margin="20,0,0,0" 
                          VerticalScrollBarVisibility="Auto">
                <StackPanel>

                    <!-- بطاقة الشبكة -->
                    <ui:CardAction Click="BtnNetwork_Click" Margin="0,0,0,15">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource CardNetworkTitle}" 
                                       FontSize="16" FontWeight="Bold"/>
                            <TextBlock Text="{DynamicResource CardNetworkDesc}" 
                                       FontSize="12" Foreground="#94A3B8" 
                                       TextWrapping="Wrap" Margin="0,5,0,0"/>
                        </StackPanel>
                    </ui:CardAction>

                    <!-- بطاقة التحديثات -->
                    <ui:CardAction Click="BtnUpdate_Click" Margin="0,0,0,15">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource CardUpdateTitle}" 
                                       FontSize="16" FontWeight="Bold"/>
                            <TextBlock Text="{DynamicResource CardUpdateDesc}" 
                                       FontSize="12" Foreground="#94A3B8" 
                                       TextWrapping="Wrap" Margin="0,5,0,0"/>
                        </StackPanel>
                    </ui:CardAction>

                    <!-- بطاقة الصوت -->
                    <ui:CardAction Click="BtnSound_Click" Margin="0,0,0,15">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource CardSoundTitle}" 
                                       FontSize="16" FontWeight="Bold"/>
                            <TextBlock Text="{DynamicResource CardSoundDesc}" 
                                       FontSize="12" Foreground="#94A3B8" 
                                       TextWrapping="Wrap" Margin="0,5,0,0"/>
                        </StackPanel>
                    </ui:CardAction>

                    <!-- بطاقة المتجر -->
                    <ui:CardAction Click="BtnStore_Click" Margin="0,0,0,15">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource CardStoreTitle}" 
                                       FontSize="16" FontWeight="Bold"/>
                            <TextBlock Text="{DynamicResource CardStoreDesc}" 
                                       FontSize="12" Foreground="#94A3B8" 
                                       TextWrapping="Wrap" Margin="0,5,0,0"/>
                        </StackPanel>
                    </ui:CardAction>

                    <!-- بطاقة الفحص الشامل -->
                    <ui:CardAction Click="BtnScan_Click" Margin="0,0,0,15">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource CardScanTitle}" 
                                       FontSize="16" FontWeight="Bold"/>
                            <TextBlock Text="{DynamicResource CardScanDesc}" 
                                       FontSize="12" Foreground="#94A3B8" 
                                       TextWrapping="Wrap" Margin="0,5,0,0"/>
                        </StackPanel>
                    </ui:CardAction>

                    <!-- زر التصدير -->
                    <Button Click="BtnExport_Click"
                            Background="#22C55E" Foreground="White"
                            Padding="20,15" FontSize="14" FontWeight="Bold">
                        <TextBlock Text="{DynamicResource BtnExport}" TextWrapping="Wrap"/>
                    </Button>

                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</ui:FluentWindow>
