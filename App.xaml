<Application x:Class="WinRescuePro.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- WPF-UI Themes -->
                <ResourceDictionary Source="pack://application:,,,/WPF-UI;component/Styles/Theme/Dark.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/WPF-UI;component/Styles/WpfUi.xaml"/>
                
                <!-- Localization -->
                <ResourceDictionary Source="Resources/Strings.ar.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
